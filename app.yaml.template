# Render this manifest during deployment using the bundle inputs named in double braces. The
# repository deliberately does not commit a workspace-specific app.yaml.
command:
  - uvicorn
  - backend.main:app
  - --host
  - 0.0.0.0
  - --port
  - "8000"
env:
  - name: APP_ADAPTER
    value: lakebase
  - name: LAKEBASE_ENDPOINT
    valueFrom: lakebase
  - name: MODEL_ENDPOINT
    valueFrom: agent-model-service
  - name: MLFLOW_TRACKING_URI
    value: databricks
  - name: MLFLOW_EXPERIMENT_ID
    valueFrom: agent-mlflow-experiment
  - name: MLFLOW_TRACING_DESTINATION
    value: "{{mlflow_trace_catalog}}.{{mlflow_trace_schema}}"
  - name: MLFLOW_TRACING_SQL_WAREHOUSE_ID
    valueFrom: sql-warehouse
  - name: GOVERNED_MCP_ENDPOINT
    value: "{{workspace_host}}/ai-gateway/mcp-services/{{catalog}}.{{schema}}.{{mcp_service_name}}"
  - name: GOVERNED_SKILL_ENDPOINT
    value: "{{workspace_host}}/ai-gateway/skills/?schema={{catalog}}.{{schema}}"
  - name: GOVERNED_SKILL_TOOL
    value: "skill_{{catalog}}.{{schema}}.{{governed_skill_name}}"
  - name: GOVERNED_SKILL_DOCUMENT_URL
    value: "{{workspace_host}}/api/2.0/fs/files/Skills/{{catalog}}/{{schema}}/{{governed_skill_name}}/SKILL.md"
  - name: LAKEBASE_SCHEMA
    value: "{{lakebase_schema}}"
  - name: GLOBAL_AGENT_CONCURRENCY
    value: "{{global_agent_concurrency}}"
  - name: SSE_COALESCE_SECONDS
    value: "0.05"
  - name: TELEMETRY_RETENTION_SECONDS
    value: "86400"
  - name: TELEMETRY_RETENTION_INTERVAL_SECONDS
    value: "300"
  - name: TELEMETRY_RETENTION_BATCH_SIZE
    value: "1000"
